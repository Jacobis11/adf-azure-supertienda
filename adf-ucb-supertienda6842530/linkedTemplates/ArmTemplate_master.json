{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ucb-supertienda6842530"
		},
		"ls_sa_supertienda_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_sa_supertienda'"
		},
		"ls_sql_supertienda_bronze_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_supertienda_bronze'"
		},
		"ls_sql_supertienda_silver_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_supertienda_silver'"
		},
		"ls_sql_supertienda_bronze_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-supertienda6842530.database.windows.net"
		},
		"ls_sql_supertienda_bronze_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "supertiendadb-bronze"
		},
		"ls_sql_supertienda_bronze_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "jacob"
		},
		"ls_sql_supertienda_silver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-supertienda6842530.database.windows.net"
		},
		"ls_sql_supertienda_silver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "supertiendadb-silver"
		},
		"ls_sql_supertienda_silver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "jacob"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-ucb-supertienda6842530_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_sa_supertienda_connectionString": {
						"value": "[parameters('ls_sa_supertienda_connectionString')]"
					},
					"ls_sql_supertienda_bronze_password": {
						"value": "[parameters('ls_sql_supertienda_bronze_password')]"
					},
					"ls_sql_supertienda_silver_password": {
						"value": "[parameters('ls_sql_supertienda_silver_password')]"
					},
					"ls_sql_supertienda_bronze_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_supertienda_bronze_properties_typeProperties_server')]"
					},
					"ls_sql_supertienda_bronze_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_supertienda_bronze_properties_typeProperties_database')]"
					},
					"ls_sql_supertienda_bronze_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_supertienda_bronze_properties_typeProperties_userName')]"
					},
					"ls_sql_supertienda_silver_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_supertienda_silver_properties_typeProperties_server')]"
					},
					"ls_sql_supertienda_silver_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_supertienda_silver_properties_typeProperties_database')]"
					},
					"ls_sql_supertienda_silver_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_supertienda_silver_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-ucb-supertienda6842530_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-ucb-supertienda6842530_ArmTemplate_0')]"
			]
		}
	]
}